## Hallow brand
##
## Hallow is built from Mozilla Firefox. -brand-product-name stays "Firefox"
## because Firefox strings use it for the engine and its documentation
## (e.g. "Firefox Account", support pages).

-brand-shorter-name = Hallow
-brand-short-name = Hallow
-brand-shortcut-name = Hallow
-brand-full-name = Hallow
-brand-product-name = Firefox
-vendor-short-name = Mozilla
trademarkInfo = Hallow is built from Mozilla Firefox and is not affiliated with Mozilla.
