Refuse older builds and non-HTTPS update packages

Hallow releases of one Firefox version (157.0-7, 157.0-8) share the
application version, so the update service compares build IDs within a
version: only a later build is newer. Firefox only refuses the same build,
which would let an older Hallow build of the same version be offered again.
An update without a version or build ID is never newer.

Update packages are downloaded over HTTPS only (plain HTTP from this machine
alone, for Hallow's update tests). MAR signatures are verified either way.

diff --git a/toolkit/mozapps/update/UpdateService.sys.mjs b/toolkit/mozapps/update/UpdateService.sys.mjs
index 1166c7b..4b61ec8 100644
--- a/toolkit/mozapps/update/UpdateService.sys.mjs
+++ b/toolkit/mozapps/update/UpdateService.sys.mjs
@@ -1953,13 +1953,53 @@ function pingStateAndStatusCodes(aUpdate, aStartup, aStatus) {
  * version and build ID values passed. Otherwise it returns false.
  */
 function updateIsAtLeastAsOldAs(update, version, buildID) {
-  if (!update || !update.appVersion || !update.buildID) {
+  if (!update) {
     return false;
   }
+  // Hallow: an update that does not say which version and build it is, is
+  // never newer. Hallow releases of the same Firefox version (157.0-7,
+  // 157.0-8) share the application version, so within a version only a
+  // later build is newer: Firefox only refuses the same build ID, which would
+  // let an older Hallow build of the same version be offered again.
+  if (!update.appVersion || !update.buildID) {
+    return true;
+  }
   let versionComparison = Services.vc.compare(update.appVersion, version);
   return (
     versionComparison < 0 ||
-    (versionComparison == 0 && update.buildID == buildID)
+    (versionComparison == 0 && !isLaterBuildID(update.buildID, buildID))
+  );
+}
+
+/**
+ * Hallow: whether build ID `a` (YYYYMMDDhhmmss) is later than `b`. Build IDs
+ * that are not plain numbers are never later.
+ */
+function isLaterBuildID(a, b) {
+  if (!/^\d{1,20}$/.test(a) || !/^\d{1,20}$/.test(b)) {
+    return false;
+  }
+  return BigInt(a) > BigInt(b);
+}
+
+/**
+ * Hallow: update packages are only downloaded over HTTPS. Plain HTTP is
+ * accepted from this machine alone (127.0.0.1, ::1, localhost), which Hallow's
+ * update tests serve from. MAR signatures are verified either way.
+ */
+function isAllowedPatchURL(spec) {
+  let uri;
+  try {
+    uri = Services.io.newURI(spec);
+  } catch (e) {
+    return false;
+  }
+  if (uri.scheme == "https") {
+    return true;
+  }
+  return (
+    uri.scheme == "http" &&
+    ["127.0.0.1", "[::1]", "::1", "localhost"].includes(uri.host)
   );
 }
 
