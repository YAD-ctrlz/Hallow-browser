+
+; Hallow installs per user, into %LOCALAPPDATA%\Hallow and registered in
+; HKCU, so neither installing nor updating ever asks for administrator rights.
+; Turn the UAC elevation the shared installer code would request into a no-op.
+!macro HallowNoElevation
+!macroend
+!define ElevateUAC "!insertmacro HallowNoElevation"
