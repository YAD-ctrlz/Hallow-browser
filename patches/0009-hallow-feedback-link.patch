Send Settings feedback to Hallow

Settings > About Hallow > "Share ideas and feedback" pointed at Mozilla
Connect; send it to Hallow's issue tracker instead. ("Get help" keeps
opening Firefox's documentation for the same Settings page.)

diff --git a/browser/components/preferences/config/about-firefox.mjs b/browser/components/preferences/config/about-firefox.mjs
index c28905c8da..d80c50727f 100644
--- a/browser/components/preferences/config/about-firefox.mjs
+++ b/browser/components/preferences/config/about-firefox.mjs
@@ -581,7 +581,8 @@ SettingGroupManager.registerGroups({
             l10nId: "support-share-ideas",
             control: "moz-box-link",
             controlAttrs: {
-              href: "https://connect.mozilla.org/",
+              // Hallow: ideas and feedback go to Hallow, not Mozilla Connect.
+              href: "https://github.com/YAD-ctrlz/Hallow-browser/issues",
             },
           },
         ],
