@@ -424,6 +435,100 @@ export class AppUpdater {
     return Services.sysinfo.getProperty("isPackagedApp");
   }
 
+  /**
+   * Hallow: Linux package installations, where Gecko's updater cannot
+   * apply updates, are updated through the system package manager from
+   * Hallow's signed stable channel instead (LinuxPackageUpdater). Null
+   * everywhere else.
+   */
+  get #packageUpdater() {
+    if (AppConstants.platform != "linux" || !this.#updateDisabledByPackage) {
+      return null;
+    }
+    const updater = lazy.LinuxPackageUpdater;
+    return updater.available ? updater : null;
+  }
+
+  /**
+   * Whether restarting switches to an update the package manager installed.
+   */
+  get packageRestartPending() {
+    return this.#packageRestartPending;
+  }
+
+  /**
+   * `check()` for package installations: the same states as Gecko's
+   * updater, so the About dialog and Settings show it the same way. The
+   * update is installed once the user agrees (allowUpdateDownload), and the
+   * system asks for an administrator password.
+   */
+  async #checkPackageUpdate(updater) {
+    if (Services.policies && !Services.policies.isAllowed("appUpdate")) {
+      this.#setStatus(AppUpdater.STATUS.UPDATE_DISABLED_BY_POLICY);
+      return;
+    }
+    this.#setStatus(AppUpdater.STATUS.CHECKING);
+    let result;
+    try {
+      result = await makeAbortable(updater.check());
+    } catch (e) {
+      if (e instanceof AbortError) {
+        throw e;
+      }
+      console.error(e);
+      this.#setStatus(AppUpdater.STATUS.CHECKING_FAILED);
+      return;
+    }
+    LOG(`AppUpdater:#checkPackageUpdate - ${result.status} ${result.version}`);
+    if (result.status == "up-to-date") {
+      this.#setStatus(AppUpdater.STATUS.NO_UPDATES_FOUND);
+      return;
+    }
+    // Not an nsIUpdate: the UI only reads the version from it.
+    this.#_update = {
+      displayVersion: result.version,
+      appVersion: result.version,
+      buildID: "",
+    };
+    if (result.status == "restart") {
+      this.#packageRestartPending = true;
+      this.#setStatus(AppUpdater.STATUS.READY_FOR_RESTART);
+      return;
+    }
+    for (;;) {
+      const permission = new Promise(resolve => {
+        this.#permissionToDownloadGivenFn = resolve;
+      });
+      this.#setStatus(AppUpdater.STATUS.DOWNLOAD_AND_INSTALL);
+      await makeAbortable(permission);
+      this.#permissionToDownloadGivenFn = null;
+      this.#setStatus(AppUpdater.STATUS.STAGING);
+      let outcome;
+      try {
+        outcome = await makeAbortable(updater.install());
+      } catch (e) {
+        if (e instanceof AbortError) {
+          throw e;
+        }
+        console.error(e);
+        this.#setStatus(AppUpdater.STATUS.DOWNLOAD_FAILED);
+        return;
+      }
+      LOG(`AppUpdater:#checkPackageUpdate - install: ${outcome}`);
+      if (outcome == "installed") {
+        this.#packageRestartPending = true;
+        this.#setStatus(AppUpdater.STATUS.READY_FOR_RESTART);
+        return;
+      }
+      if (outcome == "up-to-date") {
+        this.#_update = null;
+        this.#setStatus(AppUpdater.STATUS.NO_UPDATES_FOUND);
+        return;
+      }
+      // "cancelled": the password prompt was dismissed; offer it again.
+    }
+  }
+
