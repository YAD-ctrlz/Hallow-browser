#!/bin/sh
set -e

APPARMOR_PROFILE=/etc/apparmor.d/hallow

case "$1" in
remove|purge)
    if [ -e "$APPARMOR_PROFILE" ]; then
        if command -v apparmor_parser >/dev/null 2>&1 &&
            aa-enabled --quiet 2>/dev/null; then
            apparmor_parser --remove "$APPARMOR_PROFILE" || true
        fi
        rm -f "$APPARMOR_PROFILE"
    fi
    ;;
esac

exit 0
